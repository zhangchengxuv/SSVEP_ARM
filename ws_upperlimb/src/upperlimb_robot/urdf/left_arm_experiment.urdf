<robot name="robot_urdf">

  <!-- ===== 材质定义 ===== -->
  <material name="dark_graphite">
    <color rgba="0.36 0.40 0.45 1.0" />
  </material>

  <material name="light_mist">
    <color rgba="0.82 0.84 0.86 1.0" />
  </material>

  <!-- ===== world ===== -->
  <link name="world" />

  <joint name="world_to_base_link" type="fixed">
    <parent link="world" />
    <child link="base_link" />
    <origin xyz="0 0 0" rpy="1.5708 0 0" />
  </joint>

  <!-- ===== base ===== -->
  <link name="base_link">
    <inertial>
      <origin xyz="6.92226091852932E-06 -0.0238445782558473 0.0400185415811058" rpy="0 0 0" />
      <mass value="2.0518821290605" />
      <inertia
        ixx="0.0033819502523036"
        ixy="-6.94931922672838E-07"
        ixz="3.13273230530948E-07"
        iyy="0.0025562496259904"
        iyz="0.000421721476417986"
        izz="0.00278965644158957" />
    </inertial>
    <visual>
      <geometry>
        <mesh filename="package://robot_urdf/meshes/base_link.STL" />
      </geometry>
      <material name="dark_graphite" />
    </visual>
  </link>

